# LLM Proxy configuration file.
#
# Copy to ~/.config/llm-proxy/config.toml and adjust settings.
# Generate a default config by running: llm-proxy init

[server]
bind = "127.0.0.1:3456"
request_timeout = "300s"
log_level = "info"
# Structured log output: "plain" (default) or "json". Also settable via the
# RUST_LOG_FORMAT env var, which wins at startup.
# log_format = "plain"
hot_reload = false
# Requests per minute allowed per client IP. 0 disables rate limiting.
# Direct loopback connections are exempt unless trust_forwarded_headers = true.
rate_limit_rpm = 100
# Use X-Forwarded-For / X-Real-IP for client identity. Enable only behind a
# trusted reverse proxy that overwrites these headers.
trust_forwarded_headers = false
# Window for rejecting identical path/body requests. "0ms" disables dedup.
dedup_window = "0ms"
server_name = "llm-proxy"
# Dedicated listener for the read-only admin /usage API. Only read when
# [auth.admin] is configured. Defaults to "127.0.0.1" on the port after
# `bind` (loopback-only); set it explicitly to point at a tunnel interface
# or a different port. Must differ from `bind`.
# admin_bind = "127.0.0.1:3457"
# Also serve /usage on the main listener behind the same admin token.
# Off by default; enabling it names a distinct security posture
# ("admin-on-main-listener") that startup warns about loudly: the admin
# surface then reaches every network the main listener does. With no
# explicit admin_bind set, this posture serves /usage on the main listener
# only (no dedicated socket) — the option for setups where a second port
# is not available.
# admin_on_main_listener = false

# Context-window preflight. "warn" (default) logs when the request may
# not fit; "enforce" also rejects (400), but only when the estimated
# input exceeds the window by margin_tokens — estimates use chars/4 for
# non-OpenAI models and never count tools or images, so marginal cases
# only warn.
[server.preflight]
mode = "warn"
margin_tokens = 512

# Client authentication for proxy routes.
#
# mode = "none" (default): no client authentication. Only permitted while
# [server].bind is a loopback address; the server refuses to start on a
# non-loopback bind without client keys.
[auth]
mode = "none"
# mode = "client-keys": every proxy request must present
# "Authorization: Bearer <client-key>". Named keys map key ids to argon2id
# password hashes in PHC format -- never plaintext secrets. Generate one with
# e.g. `printf 'my-secret' | argon2 'some-salt' -id -e`.
# The key id (not the secret) appears in usage events and rate-limit keys.
#
# [auth]
# mode = "client-keys"
#
# Present each key as "<key-id>.<secret>", e.g.
#   Authorization: Bearer laptop.2V7mZ9xQ4k...
# The id prefix selects exactly one verifier, so a wrong token costs at
# most one argon2 run regardless of how many keys exist. A bare secret
# with no dot still works (checked against every key in turn), but its
# lookup cost grows with the key count.
#
# [auth.clients]
# laptop = "$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHQ$..."
#
# A key may instead be a table carrying its admission policy:
#
# [auth.clients.laptop]
# verifier = "$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHQ$..."
# # Glob allowlists. A restricted key whose request names no model is
# # refused (403) rather than passed through unattributed.
# allow_models = ["claude-*", "gpt-4o"]
# allow_providers = ["anthropic", "openai"]
# [auth.clients.laptop.limits]
# rpm = 60
# tpm = 200_000
# rpd = 5_000
# [auth.clients.laptop.budget]
# # Spend cap per UTC day. Requests reserve their estimated cost first
# # (input estimate + max_tokens at the model's pricing), so concurrent
# # requests cannot overspend it by more than what is reserved. A model
# # with no pricing entry cannot be estimated: "reject" it (default) or
# # reserve a fixed amount:
# usd_per_day = "10.00"
# # unestimatable = "reject"
# # unestimatable = { reserve_usd = { usd = "0.50" } }

# Usage ledger persistence. Absent (the default) disables persistence:
# usage events go to an in-memory no-op sink and nothing is written to disk.
#
# [storage]
# SQLite database file. Parent directories are created at startup.
# path = "${HOME}/.local/state/llm-proxy/usage.db"
# Delete ledger rows older than this age; absent keeps rows forever.
# max_age = "30d"
# Keep at most this many rows; the oldest rows are deleted when the cap is
# exceeded. Absent means unlimited.
# max_rows = 1000000
# How often retention pruning runs. Default "1h"; must be at least "1s".
# prune_interval = "1h"

# Admin API for the usage ledger. Absent (the default) disables the /usage
# surface entirely. Requires [storage]; every /usage route on every mount
# demands "Authorization: Bearer <admin-token>" (compared in constant time).
#
# [auth.admin]
# token = "${ADMIN_TOKEN}"
