{
  "model": "claude-sonnet-4-5",
  "max_tokens": 1024,
  "system": [
    {
      "type": "text",
      "text": "You are a terse weather assistant.",
      "cache_control": {
        "type": "ephemeral",
        "ttl": "1h"
      }
    }
  ],
  "tools": [
    {
      "name": "get_weather",
      "description": "Get the current weather for a city.",
      "input_schema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "enum": [
              "C",
              "F"
            ]
          }
        },
        "required": [
          "city"
        ]
      }
    }
  ],
  "tool_choice": {
    "type": "auto",
    "disable_parallel_tool_use": true
  },
  "temperature": 0.2,
  "top_p": 0.9,
  "top_k": 40,
  "stop_sequences": [
    "\n\nHuman:"
  ],
  "metadata": {
    "user_id": "user_capture_fixture"
  },
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "What is the weather in SF? Also look at this photo."
        },
        {
          "type": "image",
          "source": {
            "type": "base64",
            "media_type": "image/png",
            "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFAAH/q842iQAAAABJRU5ErkJggg=="
          }
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "tool_use",
          "id": "toolu_sdk_01",
          "name": "get_weather",
          "input": {
            "city": "SF",
            "unit": "F"
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "toolu_sdk_01",
          "content": [
            {
              "type": "text",
              "text": "72F and foggy"
            }
          ],
          "is_error": false
        }
      ]
    }
  ]
}
